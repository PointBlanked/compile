# Copy to .env.proxy (git-ignored). Values go only to the proxy VM.
# sha256 of each device token the phones will present:  printf '%s' "$TOKEN" | shasum -a 256
DEVICE_TOKEN_SHA256S=
GEMINI_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ALLOWED_MODELS=gemini-2.5-flash,gpt-4o
RATE_PER_MINUTE=30
